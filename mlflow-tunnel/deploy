#!/usr/bin/env bash

set -euo pipefail

source_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
config_home=${XDG_CONFIG_HOME:-$HOME/.config}

install_link() {
    local source=$1 destination=$2 current
    mkdir -p -- "$(dirname -- "$destination")"
    if [[ -L $destination ]]; then
        current=$(readlink -f -- "$destination")
        if [[ $current == "$(readlink -f -- "$source")" ]]; then
            return 0
        fi
        printf 'mlflow-tunnel deploy: refusing unexpected symlink: %s\n' "$destination" >&2
        return 1
    fi
    if [[ -e $destination ]]; then
        printf 'mlflow-tunnel deploy: refusing existing path: %s\n' "$destination" >&2
        return 1
    fi
    ln -s -- "$source" "$destination"
}

install_link "$source_dir/mlflow-tunnel" "$HOME/.local/bin/mlflow-tunnel"
install_link "$source_dir/mlflow-tunnel@.service" "$config_home/systemd/user/mlflow-tunnel@.service"
install_link "$source_dir/targets" "$config_home/mlflow-tunnel/targets"
install_link "$source_dir/login-hook.bash" "$config_home/mlflow-tunnel/login-hook.bash"

systemctl --user daemon-reload
printf 'MLflow tunnel files deployed (instances remain disabled and stopped).\n'
